<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kept to the attributes that exist in the schema of PHPUnit 9.5, 10.5 and 11 alike.
  Removed: backupStaticAttributes, verbose, convert*ToExceptions (gone in PHPUnit 10)
  and the filter/whitelist block, which pointed at src/ - a directory this package does
  not have, so it configured coverage for nothing. When coverage is wanted, pass the
  coverage-filter and coverage-html options to vendor/bin/phpunit on the command line.

  Data providers carry #[DataProvider] attributes as well as their @dataProvider
  doc-comments. PHPUnit 9.6 does not read attributes - they are ordinary PHP 8
  syntax and it ignores them - so the doc-comments are what keeps Laravel 8 and 9
  working; PHPUnit 10 and newer read the attribute and leave the doc-comment alone,
  so nothing is provided twice. Measured on PHP 8.3.36, with and without the
  attributes, nothing else changed:

      L8.83.29  / PHPUnit 9.6.38   117 tests / 229 assertions  ->  unchanged
      L12.71.0  / PHPUnit 11.5.57  117 / 229, 6 deprecations   ->  117 / 229, 1
      L13.40.0  / PHPUnit 12.5.43   65 / 160 with 5 errors     ->  117 / 229

  The PHPUnit 12 line is the reason this exists: that version ignores doc-comment
  metadata outright, so before the attributes 52 tests were silently not discovered.

  One doc-comment is left: @covers in SkipFileLoadingTest, the single remaining
  deprecation under PHPUnit 11. Its attribute form, #[CoversMethod], only exists
  from PHPUnit 11 onwards and would break the PHPUnit 10.5 line, and unlike
  @dataProvider, losing @covers drops a coverage restriction rather than a test.
-->
<phpunit
    backupGlobals="false"
    beStrictAboutChangesToGlobalState="true"
    beStrictAboutOutputDuringTests="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    bootstrap="vendor/autoload.php"
    cacheResult="true"
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
>

    <!-- List of files with tests inside -->
    <testsuites>
        <testsuite name="Package Test Suite">
            <directory suffix="Test.php">tests/</directory>
        </testsuite>
    </testsuites>

</phpunit>
